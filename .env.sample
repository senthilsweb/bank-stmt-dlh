# Copy to .env and fill in. Never commit .env. Names that are not secrets live in config/settings.yaml.

# Password of the bank statement PDFs (HDFC sets one per account). Leave empty for the synthetic samples
PDF_PASSWORD=
# Folder holding the statement PDFs on this machine (local runs and `make upload`; defaults to data/raw)
STATEMENTS_DIR=
# Jev (TypeSafe AI), used only for rows the rules cannot categorize. Empty = no AI step
TYPESAFE_API_KEY=

# Databricks (Free Edition works). Host like https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# SQL warehouse HTTP path, from the warehouse's Connection details
DATABRICKS_HTTP_PATH=
# Your workspace login. Code is deployed under /Users/<DATABRICKS_USER>/bank-stmt-dlh
DATABRICKS_USER=
# Who gets a mail when a job fails (defaults to DATABRICKS_USER)
ALERT_EMAIL=
# Catalog name; must match `catalog` in config/settings.yaml. Create it once by hand
DATABRICKS_CATALOG=bank_stmt_dlh
# Written by `make etl`; leave empty
DATABRICKS_JOB_ID=
DATABRICKS_REPORT_JOB_ID=

# Statement source A: MinIO or any S3-compatible bucket (statement_source: minio in config/settings.yaml).
# Use a key limited to one bucket, not the root account. Bucket and prefix are in config/settings.yaml
MINIO_ENDPOINT=https://minio.example.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=bank-stmt-dlh

# Statement source B: a SharePoint folder read through Microsoft Graph (statement_source: sharepoint).
# Cookbook: docs/cookbook/sharepoint-source-setup.md
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_SITE_HOST=<tenant>.sharepoint.com
SP_SITE_PATH=
SP_LIBRARY=Shared Documents
SP_FOLDER=<path to the statements folder, e.g. Finance/Bank Statements/2026>
SP_SITE_ID=
SP_DRIVE_ID=
SP_FOLDER_ID=
SP_MONTHLY_FOLDER_ID=
SP_WEEKLY_FOLDER_ID=

# Weekly cash report mail through Microsoft Graph. Cookbook: docs/cookbook/graph-mail-setup.md
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_SENDER=noreply@<domain>
# comma-separated address|Display Name entries
MAIL_RECIPIENTS=
MAIL_DRY_RUN_TO=
# dry sends only to MAIL_DRY_RUN_TO; live sends to MAIL_RECIPIENTS
MAIL_MODE=dry
# Optional Reply-To, a mailbox people read. Empty: replies go to MAIL_SENDER
MAIL_REPLY_TO=

# Maintainers only: where `make publish` writes the public copy of the source (a separate git repo)
# (both may also be set in config/publish.yaml)
PUBLIC_REPO_DIR=
PUBLIC_GIT_AUTHOR=
